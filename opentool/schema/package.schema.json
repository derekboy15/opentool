{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opentool export package (package.json), contract 1.x",
  "type": "object",
  "required": ["contract", "adapter", "reader", "game", "unit", "model", "format", "units", "up_axis", "bind_pose_ok",
               "rig_map", "clips", "mesh_groups", "weapons", "loadouts", "default_loadout", "textures", "provenance",
               "credits", "warnings"],
  "properties": {
    "contract": {"type": "string", "pattern": "^1\\."},
    "adapter": {"type": "object", "required": ["name", "version"]},
    "reader": {"type": "object", "required": ["name", "version"]},
    "game": {"type": "string"},
    "unit": {"type": "object", "required": ["id", "name", "group", "class_hint", "class_confidence"],
             "properties": {"class_hint": {"enum": ["infantry", "walker", "bike", "monster", "vehicle", "flyer", "other"]},
                            "class_confidence": {"enum": ["high", "medium", "low"]}}},
    "model": {"type": "string", "pattern": "^[^:\\\\]+$", "description": "file inside the package, relative, forward slashes"},
    "format": {"enum": ["fbx", "glb", "gltf"]},
    "units": {"type": "object", "required": ["metres_per_unit"],
              "description": "metres per unit of the model AS BLENDER IMPORTS IT (a hint; scale rules decide)"},
    "up_axis": {"enum": ["Z", "Y"]},
    "handedness": {"enum": ["right", "left"]},
    "bind_pose_ok": {"type": "boolean"},
    "rig_map": {"type": "object", "description": "canonical role -> game bone name (matched as a suffix)"},
    "clips": {"type": "array", "items": {"type": "object", "required": ["name", "role"],
              "properties": {"role": {"enum": ["idle", "aim", "shoot", "move", "melee", "die", "other"]},
                             "frames": {"type": "array"}, "fps": {"type": "number"}}}},
    "mesh_groups": {"type": "array", "items": {"type": "object", "required": ["name", "role"],
                    "properties": {"role": {"enum": ["body", "head", "weapon", "banner", "part", "effect"]}}}},
    "hidden": {"type": "array", "description": "object paths the game never shows (Unity inactive objects)"},
    "weapons": {"type": "array", "items": {"type": "object", "required": ["id", "file"]}},
    "loadouts": {"type": "array", "items": {"type": "object", "required": ["id", "weapons"],
                 "properties": {"weapons": {"type": "array", "items": {"type": "object", "required": ["slot", "weapon_id", "mount"],
                                "properties": {"mount": {"type": "string", "pattern": "^(joint:.+|socket:.+|bonemerge|mesh_group:.+)$"}}}}}}},
    "default_loadout": {"type": "string"},
    "textures": {"type": "array", "items": {"type": "object", "required": ["file", "role"],
                 "properties": {"role": {"enum": ["diffuse", "normal", "mask", "other"]},
                                "encoding": {"enum": ["rgb", "dxt5nm", "bc5", "auto"]},
                                "green": {"enum": ["opengl", "directx"]}}}},
    "provenance": {"type": "object"},
    "credits": {"type": "array"},
    "warnings": {"type": "array"}
  }
}
